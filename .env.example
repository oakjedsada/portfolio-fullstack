# Copy this to .env on your VPS and fill in real values.
# Never commit the real .env file to git.

DOMAIN=yourdomain.com
DB_PASSWORD=change-this-to-a-strong-random-password

# Gmail SMTP for contact-form notification emails.
# SMTP_PASSWORD must be a Gmail "App Password" (myaccount.google.com/apppasswords),
# not your normal Gmail password.
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_NOTIFY_TO=youraddress@gmail.com
